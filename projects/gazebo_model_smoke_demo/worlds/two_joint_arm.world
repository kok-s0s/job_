<?xml version="1.0"?>
<sdf version="1.6">
  <world name="two_joint_arm_smoke_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="two_joint_arm_placeholder">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.05 0 0 0</pose>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.10</size>
            </box>
          </geometry>
        </visual>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.30 0.30 0.10</size>
            </box>
          </geometry>
        </collision>
      </link>
      <link name="arm_link">
        <pose>0.35 0 0.18 0 0 0</pose>
        <visual name="arm_visual">
          <geometry>
            <box>
              <size>0.70 0.06 0.06</size>
            </box>
          </geometry>
        </visual>
      </link>
      <joint name="base_to_arm_fixed" type="fixed">
        <parent>base_link</parent>
        <child>arm_link</child>
      </joint>
    </model>
  </world>
</sdf>

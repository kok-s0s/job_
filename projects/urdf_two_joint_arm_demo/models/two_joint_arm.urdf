<?xml version="1.0"?>
<robot name="two_joint_arm">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.030" ixy="0" ixz="0" iyy="0.030" iyz="0" izz="0.045"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
      <material name="runtime_gray">
        <color rgba="0.25 0.28 0.32 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.040" iyz="0" izz="0.040"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.06 0.06"/>
      </geometry>
      <material name="arm_blue">
        <color rgba="0.10 0.38 0.72 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="elbow_link">
    <inertial>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.018" iyz="0" izz="0.018"/>
    </inertial>
    <visual>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.05 0.05"/>
      </geometry>
      <material name="tool_green">
        <color rgba="0.10 0.55 0.32 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.08"/>
      </geometry>
      <material name="tool_orange">
        <color rgba="0.90 0.42 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.02"/>
      </geometry>
      <material name="sensor_black">
        <color rgba="0.02 0.02 0.02 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="1.2"/>
  </joint>

  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0.50 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.20" upper="1.20" effort="20" velocity="1.5"/>
  </joint>

  <joint name="tool_mount_joint" type="fixed">
    <parent link="elbow_link"/>
    <child link="tool0"/>
    <origin xyz="0.40 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="imu_mount_joint" type="fixed">
    <parent link="elbow_link"/>
    <child link="imu_link"/>
    <origin xyz="0.25 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
